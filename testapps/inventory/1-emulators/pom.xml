<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ===================================================================================
         A COMPLETE, WORKING pom.xml FOR A MIGRATED SWING APP ON VAADIN BOOT — part of the
         seed beside it, which builds exactly as shipped. Copy it over your app's pom and edit:

             cp swingbridge-migration/seed/vaadin-boot/example-pom.xml pom.xml

         Then change three things and add your own dependencies:

           1. groupId / artifactId / name              — your app's coordinates
           2. <argument>com.example.app.Main</argument> — your main()-hosting class, at the
                                                         BOTTOM, once you have moved the seed's
                                                         classes into your own package
           3. swingbridge-emulators.version            — the version you are migrating against
                                                         (the kit's README states it)

         Everything else works as it stands. Run it with:

             ./mvnw -C compile exec:exec

         Not exec:java. The add-opens flag below is a JVM *startup* flag, and exec:java runs
         inside Maven's own JVM, where it cannot be applied.

         This file is a starting point, not a frozen template — add your app's dependencies,
         plugins and profiles the way you normally would. The comments mark the few places
         where a plausible-looking edit breaks the app at runtime rather than at build time.
         =================================================================================== -->

    <groupId>com.vaadin.swingbridge.testapps</groupId>
    <artifactId>testapp-inventory-emulators</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Inventory Management System — on SwingBridge Emulators (Vaadin Boot)</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Java 24 is the floor, and it is a RUNTIME requirement first: before JEP 491 a
             virtual thread that parks inside a synchronized region pins its carrier, and the
             carrier here is the Vaadin request thread holding the session lock — so every
             blocking modal dialog deadlocks on 23 and below. Since the JVM must be 24+ anyway,
             compiling to 24 costs nothing and keeps one number in the file instead of two.
             (If you must emit older bytecode for another consumer, lower this and leave the
             enforcer rule below alone — it is the one that matters.) -->
        <maven.compiler.release>24</maven.compiler.release>

        <swingbridge-emulators.version>0.1-SNAPSHOT</swingbridge-emulators.version>
        <vaadin.version>25.3.0</vaadin.version>
        <slf4j.version>2.0.18</slf4j.version>
        <junit.version>6.1.3</junit.version>

        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    </properties>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
            <id>Vaadin Directory</id>
            <url>https://maven.vaadin.com/vaadin-addons</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- junit-bom BEFORE vaadin-bom, deliberately: among competing import-scope BOMs the
                 first declaration wins, and vaadin-bom manages junit-jupiter-api at an older
                 6.0.x. Imported second, junit-bom loses that one artifact — enough for surefire
                 to abort the forked JVM over conflicting jupiter versions. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The import-swap target. :surrogates and the blocking-dialog machinery arrive transitively — declare neither. -->
        <dependency>
            <groupId>com.vaadin.swingbridge</groupId>
            <artifactId>swingbridge-emulators</artifactId>
            <version>${swingbridge-emulators.version}</version>
        </dependency>

        <!-- Compile scope, not test: @IntentionallyStatic is carried by your src/main sources, so
             inheriting the guardrails' test scope below would hide it from every field that needs it. -->
        <dependency>
            <groupId>com.vaadin.swingbridge</groupId>
            <artifactId>swingbridge-migration-annotations</artifactId>
            <version>${swingbridge-emulators.version}</version>
        </dependency>

        <!-- ADD-ONS: they replace com.toedter:jcalendar:1.4 and com.jgoodies:forms:1.2.1. -->
        <dependency>
            <groupId>com.vaadin.swingbridge</groupId>
            <artifactId>swingbridge-emulators-jcalendar-1.4</artifactId>
            <version>${swingbridge-emulators.version}</version>
        </dependency>
        <dependency>
            <groupId>com.vaadin.swingbridge</groupId>
            <artifactId>swingbridge-emulators-jgoodies-forms-1.2.1</artifactId>
            <version>${swingbridge-emulators.version}</version>
        </dependency>

        <!-- PRINTING, optional: only if your app hands a Printable to a PrinterJob. Pulls in PDFBox.
        <dependency>
            <groupId>com.vaadin.swingbridge</groupId>
            <artifactId>swingbridge-emulators-printing</artifactId>
            <version>${swingbridge-emulators.version}</version>
        </dependency>
        -->

        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-core</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>javax.annotation</groupId>
                    <artifactId>javax.annotation-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-dev</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.github.mvysny.vaadin-boot</groupId>
            <artifactId>vaadin-boot</artifactId>
            <version>13.7</version>
        </dependency>

        <!-- Declared explicitly at compile scope because this app EMBEDS its servlet container:
             there is nobody to "provide" the API jar. It does arrive transitively from Jetty at
             compile scope, but the vaadin-bom import above manages it to `provided`, which drops
             it off the runtime classpath exec:exec uses — and the app then dies at boot with
             NoClassDefFoundError: jakarta/servlet/ServletContext, a message naming neither a
             dependency nor a scope. Omitting <scope> inherits the managed `provided` and changes
             nothing, so the element is load-bearing. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.1.0</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- The app's own non-UI dependencies, as its pre-migration pom declared them. -->
        <dependency>
            <groupId>org.hibernate</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>5.6.15.Final</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.1.214</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>net.sourceforge.jexcelapi</groupId>
            <artifactId>jxl</artifactId>
            <version>2.6.12</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.12.0</version>
        </dependency>

        <!-- The migration guardrails: a build-time gate, test-scope so neither it nor the ArchUnit
             it runs on reaches your runtime. It checks that every static is provably immutable or
             annotated, that no component sits in a static field, and that nothing exits the JVM —
             which is what keeps the static sweep done once you have done it. -->
        <dependency>
            <groupId>com.vaadin.swingbridge</groupId>
            <artifactId>swingbridge-migration-guardrails</artifactId>
            <version>${swingbridge-emulators.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- No version of its own: the junit-bom above supplies it. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>

            <!-- Moves the JDK-24 failure from first page load to build time. Without it, a build
                 on 24 deployed onto 21 passes every gate and then hangs on its first dialog. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-jdk-24-plus</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[24,)</version>
                                    <message>A migrated app needs a JDK 24+ runtime (JEP 491 unpins the modal-dialog executor).</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- prepare-frontend in the default build; build-frontend only under -Pproduction.
                 A dev-mode run builds its bundle at runtime, so the default build has no reason
                 to run npm and vite. -->
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <version>${vaadin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-frontend</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!-- The guardrail gate runs here, and anything of yours that drives a modal
                         dialog runs its continuation on a virtual thread, so the test JVM needs
                         the same flag as the app JVM. -->
                    <argLine>--add-opens java.base/java.lang=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>

            <!-- Forked JVM, so the add-opens flag applies at all. ARGUMENT ORDER IS LOAD-BEARING
                 and getting it wrong fails SILENTLY: JVM flags and the classpath come BEFORE the
                 main class, and anything after the main class is handed to your app as a program
                 argument. A misplaced flag is ignored without a word, and the app then refuses to
                 start with an InaccessibleObjectException naming java.lang — so do not tidy this list.

                 The last argument is the one line you must change: your main()-hosting class. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <!-- classpathScope=test and the target/run working directory are the stage-1 app's:
                     -Pfile-db needs target/test-classes ahead of target/classes, and the app writes
                     ./log/ (and under -Pfile-db ./inventoryApp.db) relative to its working directory. -->
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <classpathScope>test</classpathScope>
                    <workingDirectory>${project.build.directory}/run</workingDirectory>
                    <arguments>
                        <argument>--add-opens</argument>
                        <argument>java.base/java.lang=ALL-UNNAMED</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>com.ca.ui.Main</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- File-backed H2 instead of the in-memory default, as in the stage-1 app: its
             hibernate.cfg.xml shadows src/main/resources on the test classpath. `clean` is not
             optional when switching modes. -->
        <profile>
            <id>file-db</id>
            <build>
                <testResources>
                    <testResource><directory>src/test/resources-filedb</directory></testResource>
                </testResources>
            </build>
        </profile>
        <profile>
            <id>production</id>
            <properties>
                <vaadin.productionMode>true</vaadin.productionMode>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.vaadin</groupId>
                        <artifactId>vaadin-maven-plugin</artifactId>
                        <version>${vaadin.version}</version>
                        <executions>
                            <execution>
                                <id>frontend</id>
                                <goals>
                                    <goal>prepare-frontend</goal>
                                    <goal>build-frontend</goal>
                                </goals>
                                <phase>compile</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
