<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vaadin.swingbridge.testapps</groupId>
    <artifactId>testapp-jlawyer-shape-swing</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>JLawyer-shape testapp — stage 1 (pure Swing)</name>

    <!-- Pure-Swing JLawyer-shape testbed (stage-1, Wave 2). Real javax.swing, no SB-Emulators runtime —
         no loom, so no add-opens flag and no JDK 24 floor. No deps beyond the JDK; no tests.

         STANDALONE BY DESIGN, no <parent> — see testapps/crud/swing/pom.xml's header for why.
         Run it with `./mvnw -C compile exec:exec` from here. -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    </properties>

    <build>
        <!-- Restores only Maven's default resource directory, overriding the parent's block, which
             also copies the repo-root LICENSE + PROVENANCE.md into META-INF. This app's sources are
             upstream's and are not under SB-Emulators' licence (testapps/CLAUDE.md, PROVENANCE.md
             § "Trees we do not touch"), so shipping our licence inside its jar would misstate what
             governs them. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.vaadin.swingbridge.testapps.jlawyershape.swing.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- GUI run (forked JVM, needs a display): mvn exec:exec -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <arguments>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>com.vaadin.swingbridge.testapps.jlawyershape.swing.Main</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
